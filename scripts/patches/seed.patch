+/*
+ * seed.patch (claude-plays-nethack local test build; not in vanilla 3.6.7).
+ * NETHACK_SEED=<decimal integer> in the environment makes a new game
+ * reproducible:
+ *  - init_random() seeds both RNGs (core and display) with that value
+ *    instead of sys_random_seed(), so has_strong_rngseed stays FALSE and
+ *    reseed_random() never reseeds from /dev/urandom when a level is
+ *    created or revisited;
+ *  - game logic that reads the wall clock gets a frozen one instead:
+ *    phase_of_the_moon(), friday_13th(), night() and midnight() see
+ *    SEEDED_CLOCK, and so does ubirthday (u_init()), which picks shopkeeper
+ *    names, the anthole species, unidentified glass gem prices and T-shirt
+ *    slogans.  SEEDED_CLOCK is 2001-01-01 12:00:00 UTC: a Monday, moon
+ *    phase 1 (neither new nor full), daytime.  Times that are only
+ *    reported (realtime, dumplog %D/%T, end-of-game dates) stay real.
+ * Unset or empty NETHACK_SEED leaves the game exactly as vanilla; any other
+ * value that isn't a decimal integer is fatal, so tests can't silently run
+ * unseeded.
+ */
+#define SEEDED_CLOCK ((time_t) 978350400L)
+
+/* TRUE if NETHACK_SEED is set; the seed goes to *seedp when that's non-null */
+boolean
+env_seed(seedp)
+unsigned long *seedp;
+{
+    static int state = -1; /* -1: not looked yet, 0: unseeded, 1: seeded */
+    static unsigned long seed = 0UL;
+
+    if (state < 0) {
+        char *val = nh_getenv("NETHACK_SEED"), *end;
+
+        state = 0;
+        if (val && *val) {
+            errno = 0;
+            seed = strtoul(val, &end, 10);
+            if (end == val || *end || errno) {
+                raw_printf("NETHACK_SEED=\"%s\" is not a decimal integer.",
+                           val);
+                exit(EXIT_FAILURE);
+            }
+            state = 1;
+        }
+    }
+    if (state > 0 && seedp)
+        *seedp = seed;
+    return (boolean) (state > 0);
+}
+
+/* TRUE, with *when set to the frozen game clock, if NETHACK_SEED is set */
+boolean
+seeded_clock(when)
+time_t *when;
+{
+    if (!env_seed((unsigned long *) 0))
+        return FALSE;
+    *when = SEEDED_CLOCK;
+    return TRUE;
+}
