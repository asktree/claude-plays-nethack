{
  "model": "claude-opus-4-6",
  "alwaysThinkingEnabled": true,
  "showThinkingSummaries": true,
  "enabledMcpjsonServers": ["nethack"],
  "permissions": {
    "allow": [
      "mcp__nethack__reset",
      "mcp__nethack__observe",
      "mcp__nethack__do",
      "mcp__nethack__exec"
    ]
  },
  "sandbox": {
    "enabled": true
  },
  "hooks": {
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "DEST=/Users/em/Coding/claude-plays-nethack/game/sessions; mkdir -p \"$DEST\"; SRC=$(ls -t ~/.claude/projects/-Users-em-Coding-claude-plays-nethack-game/*.jsonl 2>/dev/null | head -1); [ -n \"$SRC\" ] && cp \"$SRC\" \"$DEST/$(date +%s)-$(basename \"$SRC\")\" 2>/dev/null; true"
      }]
    }]
  }
}
